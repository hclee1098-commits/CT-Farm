# 환경 식별자. 원격 서버에는 서버 전용 env 예제를 사용하세요.
APP_ENV=LOCAL
# filepath: apps/api/.env.example - API 서버 실행에 필요한 환경 변수 예시
# 실행 환경
NODE_ENV=development

# API 포트
PORT=4000

# PostgreSQL 연결
# 루트 .env 파일의 데이터베이스 계정과 동일하게 설정하세요.
DATABASE_URL=postgresql://starter:replace_with_local_password@localhost:5432/starterdb?schema=public

# Redis 연결
REDIS_URL=redis://127.0.0.1:6379

# JWT 서명용 비밀키
# 실제 사용 시 충분히 긴 난수 문자열로 반드시 변경하세요.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# 웹에서 API 호출을 허용할 출처
# 여러 개일 경우 쉼표로 구분합니다.
CORS_ORIGINS=http://localhost:3000

# 리버스 프록시 개수
# 로컬 개발 환경에서는 0을 사용합니다.
TRUST_PROXY_HOPS=0

# 업로드 디렉터리
UPLOAD_DIR=./uploads

# 로그 수준
LOG_LEVEL=info


# MFA 비밀키 암호화용 독립 키: SETUP 신규 설치에서 자동 생성합니다.
# 기존 설치는 32바이트 난수를 HEX 64자로 설정하고 안전하게 백업하세요.
# MFA_ENCRYPTION_KEY=

# 선택형 SMTP. 로컬 Mailpit 예: 127.0.0.1:1025 (운영 TLS 필수)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=starter@example.test
# MAIL_PUBLIC_URL=http://localhost:3000
# 농장 운영 외부 연동: 기본값은 비활성입니다. 실제 .env의 비밀값은 공유하지 마세요.
# 네이버 지도 JavaScript API의 공개 Key ID입니다. 서버 비밀키를 넣지 마세요.
# NAVER_MAP_KEY_ID=
# 상담 기본값: 외부 모델을 호출하지 않는 공식 자료 탐색 안내
AI_MODE=REFERENCE
# 외부 모델 사용 시 AI_MODE=OPENAI, 아래 서버 전용 키·모델 설정과 요청별 전송 동의 필요
# AI_API_KEY=
# AI_MODEL=
AI_DAILY_TOKEN_LIMIT=30000
# 실결제 모드가 없습니다. 로컬 시험 SIMULATOR 또는 토스 테스트 전용 TOSS_TEST만 지원
PAYMENT_MODE=DISABLED
# TOSS_TEST_SECRET_KEY=test_sk_... (실제 테스트 키는 비공개 환경변수로 주입)
WEATHER_MODE=DISABLED
# 비상업 로컬 시험: OPEN_METEO_NON_COMMERCIAL
# 상업·서버 운영: 이용 계약 확인 후 OPEN_METEO_CUSTOMER 및 WEATHER_API_KEY 설정
# WEATHER_API_KEY=
# true일 때 15분마다 일정·센서 기반 자동 점검, 중복 없는 기존 알림 저장
FARM_ASSISTANT_ENABLED=false
