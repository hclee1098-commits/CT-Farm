// 프로젝트 전용 Android SDK입니다. 기존 SDK/설정/데이터를 바꾸지 않으며 새 약관을 자동 수락하지 않습니다.
import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {createHash,randomUUID} from 'node:crypto';import {spawn} from 'node:child_process';import {openSync,closeSync} from 'node:fs';
const root=process.cwd(),state=path.join(root,'.starter-state/phone-test'),sdk=path.join(state,'sdk');await fs.mkdir(state,{recursive:true});
if(!path.resolve(sdk).startsWith(path.resolve(root)+path.sep+'.starter-state'+path.sep))throw Error('SDK_PATH');
const marker=path.join(state,'sdk-owner.json');let owner;try{owner=JSON.parse(await fs.readFile(marker,'utf8'));if(owner.sdk!==sdk||owner.root!==root)throw Error('SDK_OWNER');}catch(e){if(e.code!=='ENOENT')throw e;try{await fs.access(sdk);throw Error('UNOWNED_SDK_DIRECTORY');}catch(x){if(x.code!=='ENOENT')throw x;}owner={root,sdk,runId:randomUUID()};await fs.writeFile(marker,JSON.stringify(owner));}
const report={startedAt:new Date().toISOString(),sdkLocation:'project-private .starter-state/phone-test/sdk',existingSystemSdkModified:false,newLicenseAcceptedAutomatically:false,commands:[]};
const evidence=path.join(root,'verification/ui-mobile/phone-sdk');await fs.mkdir(evidence,{recursive:true});
async function run(label,code){const startedAt=new Date().toISOString(),log=path.join(evidence,label+'.log'),fd=openSync(log,'w');const cmd=`[Console]::OutputEncoding=New-Object Text.UTF8Encoding($false); ${code}; exit $LASTEXITCODE`,args=['-NoProfile','-OutputFormat','Text','-ExecutionPolicy','Bypass','-EncodedCommand',Buffer.from(cmd,'utf16le').toString('base64')];let exitCode;try{const p=spawn('powershell.exe',args,{env:{...process.env,JAVA_HOME:'C:/Program Files/Android/Android Studio/jbr',ANDROID_HOME:sdk,ANDROID_SDK_ROOT:sdk},windowsHide:true,stdio:['ignore',fd,fd]});exitCode=await new Promise(resolve=>{p.once('error',()=>resolve(-1));p.once('exit',c=>resolve(c??-1));});}finally{closeSync(fd);}report.commands.push({label,startedAt,endedAt:new Date().toISOString(),exitCode,rawLog:path.relative(root,log)});await fs.writeFile(path.join(evidence,'results.json'),JSON.stringify(report,null,2));console.log(label+': exit '+exitCode);if(exitCode!==0)throw Error(label+' failed; see '+path.relative(root,log));}
try{
 const free=Number((await fs.statfs(root)).bavail)*Number((await fs.statfs(root)).bsize);if(free<12*1024**3)throw Error('SDK 설치 전 최소 여유 12GiB가 필요합니다.');
 const url='https://dl.google.com/android/repository/commandlinetools-win-15859902_latest.zip',expected='90ae805d20434428bffcb699c290860f19bb5f66a67e6b330067e3de801fb04a',zip=path.join(state,'commandlinetools.zip');
 let bytes;try{bytes=await fs.readFile(zip);}catch{}
 if(!bytes||createHash('sha256').update(bytes).digest('hex')!==expected){console.log('공식 Android 명령줄 도구를 내려받습니다.');const r=await fetch(url,{signal:AbortSignal.timeout(240000),redirect:'error'});if(!r.ok)throw Error('SDK_TOOLS_DOWNLOAD_'+r.status);bytes=Buffer.from(await r.arrayBuffer());if(bytes.length>200*1024**2)throw Error('SDK_TOOLS_SIZE');if(createHash('sha256').update(bytes).digest('hex')!==expected)throw Error('SDK_TOOLS_CHECKSUM');await fs.writeFile(zip,bytes);}
 report.commandLineTools={url,sha256:expected,verified:true};
 const manager=path.join(sdk,'cmdline-tools/latest/bin/sdkmanager.bat');try{await fs.access(manager);}catch{const unpack=path.join(state,'tools-unpacked');await fs.mkdir(unpack,{recursive:true});await run('extract-tools',`Expand-Archive -LiteralPath '${zip}' -DestinationPath '${unpack}' -Force`);await fs.mkdir(path.join(sdk,'cmdline-tools'),{recursive:true});await fs.rename(path.join(unpack,'cmdline-tools'),path.join(sdk,'cmdline-tools/latest'));}
 const licenses=path.join(os.homedir(),'AppData/Local/Android/Sdk/licenses');await fs.mkdir(path.join(sdk,'licenses'),{recursive:true});let reused=0;try{for(const e of await fs.readdir(licenses,{withFileTypes:true}))if(e.isFile()&&/^[a-z0-9-]+$/i.test(e.name)){await fs.copyFile(path.join(licenses,e.name),path.join(sdk,'licenses',e.name));reused++;}}catch(e){if(e.code!=='ENOENT')throw e;}report.existingLicenseFilesReused=reused;
 const packages=['platform-tools','platforms;android-37','build-tools;37.0.0','ndk;27.1.12297006','cmake;3.22.1'];report.requestedPackages=packages;
 await run('install-sdk',`& '${manager}' '--sdk_root=${sdk}' '--install' ${packages.map(x=>`'${x}'`).join(' ')}`);
 report.status='installed';report.endedAt=new Date().toISOString();await fs.writeFile(path.join(evidence,'results.json'),JSON.stringify(report,null,2));console.log('프로젝트 전용 Android SDK 준비 완료');
}catch(e){report.status='failed_or_license_required';report.error=e.message;report.endedAt=new Date().toISOString();await fs.writeFile(path.join(evidence,'results.json'),JSON.stringify(report,null,2));console.error(e.message);process.exitCode=1;}
