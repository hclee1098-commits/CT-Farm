// 실행 결과·차단·초기 실패를 구분해 증거 링크를 합칩니다.
import fs from 'node:fs/promises';import path from 'node:path';
const base='verification/ui-mobile',runs=[];
for(const d of await fs.readdir(base,{withFileTypes:true}))if(d.isDirectory())try{const file=path.join(base,d.name,'results.json');runs.push({file,...JSON.parse(await fs.readFile(file,'utf8'))});}catch{}
runs.sort((a,b)=>a.startedAt.localeCompare(b.startedAt));const latest={},failed=[];
for(const run of runs)for(const c of run.checks){latest[c.name]={...c,resultFile:run.file};if(c.exitCode!==0)failed.push({...c,resultFile:run.file,resolution:c.name==='build-doctor'?'blocked: SDK37/Build-tools37/NDK27.1 missing':'see later same-name result and guide; original failure retained'});}
const safetyFile='verification/ct-farm-ui-mobile-safety.json';let safety=null;try{safety=JSON.parse(await fs.readFile(safetyFile,'utf8'));}catch{}
const native=latest['mobile-native-api'];let sourcePackage=null;try{sourcePackage=JSON.parse(await fs.readFile('verification/ui-mobile/source-package.json','utf8'));}catch{}
const report={updatedAt:new Date().toISOString(),status:'partial: native app source and local core/API/platform exports verified; install/device validation pending',latestChecks:latest,allRunResults:runs.map(r=>r.file),failedOrBlockedCommands:failed,publicGuide:'docs/09-CT-Farm-안내/모바일앱과-디자인.md',documentationPath:'/docs-center/index.html',webUrl:'http://localhost:3000/starter',mobileSource:'apps/mobile',sharedDesign:'packages/design-tokens',newApi:['GET /api/v1/farms/:id/diary/:entryId','optional Idempotency-Key for POST /api/v1/farms and /api/v1/farms/:id/products'],schemaChanged:false,originalMigrationApplied:false,originalServerStop:false,databaseReset:false,databaseDrop:false,volumeDeletion:false,gitOperations:false,safetyEvidence:safetyFile,originalContainerIdsPreserved:safety?.initialEightContainerIdsPreserved,originalUploadsMatching:safety?.uploadAggregateMatchesRound5,rootDependencyLockUnchanged:safety?.rootLockUnchanged,sourceBackups:safety?.backups,verificationScope:{nativePostgres:native?.exitCode===0,deviceSecureStore:false,actualCameraOrGallery:false,actualMicrophone:false,actualAndroidInstall:false,actualIOSInstall:false,apkProduced:false,iosBinaryProduced:false,actualNavigationUI:false,actualKeyboardScreenReaderZoomSlowNetwork:false,sourceUIBrowser:false,browserBlock:'Computer Use ended: could not determine current browser URL safely; no fallback bypass attempted'},externalOrToolchainRequirements:['Android platform 37 / build-tools 37.0.0 / NDK 27.1.12297006','Mac + Xcode and actual iPhone signing environment','Expo/Apple account and approved signing/distribution configuration for EAS/TestFlight','isolated device-accessible STAGING HTTPS endpoint with trusted certificate'],remainingFeatures:['native voice recognition/dialogue','native GPS/map and parcel editing','calendar grid and OS push','native collaboration assignment/report and complete account/admin/IoT/sales management','actual device full scenario, image permission denial and storage fault tests','stale result and mutation cancellation tests on actual devices'],limits:['platform JS exports are not native app binaries','native API scenario uses real app client/workflow with Node transport and in-memory vault; not device UI or SecureStore proof','web build output is isolated from original .next','design token contrast is not whole WCAG AA verification','original collaboration remains disabled pending separate schema/backup/restore approval']};
report.sourcePackage=sourcePackage;report.changeReport='verification/ui-mobile/changes.log';report.cleanStandaloneDependencyInstallVerified=false;
try{const audit=JSON.parse(await fs.readFile('verification/ui-mobile/npm-audit.log','utf8'));report.dependencyAudit={rawLog:'verification/ui-mobile/npm-audit.log',checks:audit.checks.map(({stdout,stderr,...c})=>c)};if(audit.checks.some(c=>c.exitCode!==0)){report.status='partial: local implementation verified; unresolved mobile dependency advisories and native binary/device validation pending';report.remainingFeatures.unshift('compatible remediation of Expo CLI Zod3/deepmerge advisories; native reachability review');}}catch{}
report.earlyEvidenceLimit='some initial npm/SDK selection failures remain in the chat tool transcript only; no reconstructed command timestamps';
await fs.writeFile('verification/ct-farm-ui-mobile-results.json',JSON.stringify(report,null,2));console.log(JSON.stringify({runs:runs.length,retainedFailuresOrBlocks:failed.length,latestNative:native?.passed,latestApi:latest.api?.passed,latestWeb:latest.web?.passed,apkProduced:false}));
