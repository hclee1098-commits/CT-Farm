# 중앙 수집 서버는 앱과 별도 서비스로 실행합니다.
MONITOR_BIND=127.0.0.1
MONITOR_PORT=9443
MONITOR_DIR=/srv/monitor/data
MONITOR_TLS_KEY=/run/secrets/monitor.key
MONITOR_TLS_CERT=/run/secrets/monitor-fullchain.pem
MONITOR_LOCAL_WRITE_TOKEN=REPLACE_UNIQUE_32_PLUS_CHARACTERS
MONITOR_LOCAL_READ_TOKEN=REPLACE_DIFFERENT_32_PLUS_CHARACTERS
MONITOR_STAGING_WRITE_TOKEN=REPLACE_DIFFERENT_32_PLUS_CHARACTERS
MONITOR_STAGING_READ_TOKEN=REPLACE_DIFFERENT_32_PLUS_CHARACTERS
MONITOR_PRODUCTION_WRITE_TOKEN=REPLACE_DIFFERENT_32_PLUS_CHARACTERS
MONITOR_PRODUCTION_READ_TOKEN=REPLACE_DIFFERENT_32_PLUS_CHARACTERS
# 포털을 실행하는 PC에는 조회 URL과 읽기 키만 전달합니다.
MONITOR_STAGING_URL=https://monitor.example.com:9443
MONITOR_PRODUCTION_URL=https://monitor.example.com:9443
