# 서버마다 별도 파일을 생성하고 chmod 600 적용. 예시 비밀키는 사용 불가.
APP_ID=secure-myapp
APP_ENV=PRODUCTION
DEPLOY_ENV=production
NODE_ENV=production
POSTGRES_USER=myapp_production
POSTGRES_DB=secure_myapp_production
POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
DATABASE_URL=postgresql://myapp_production:URL_ENCODED_PASSWORD@postgres:5432/secure_myapp_production
JWT_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
BACKUP_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
SITE_DOMAIN=production.example.com
MONITOR_INGEST_URL=https://monitor.example.com:9443
MONITOR_WRITE_TOKEN=REPLACE_WITH_PRODUCTION_WRITE_TOKEN
# 파일을 생성 후 권한 1000:1000 및 0700 설정 (문서 참조)
MONITOR_DIR=/srv/secure-starter/app/.starter-state/monitoring
# 서버에 별도 배치한 서명키 경로. 운영 서버에는 개인키를 복사하지 않습니다.
STAGING_RECEIPT_PRIVATE_KEY=/run/secrets/staging-receipt.key
STAGING_RECEIPT_PUBLIC_KEY=/run/secrets/staging-receipt.pub
PRODUCTION_APPROVAL_PUBLIC_KEY=/run/secrets/production-approval.pub
# 기본값: 기존 마이그레이션을 자동 실행하지 않음. 검토 후 1로 설정.
DEPLOY_MIGRATE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
