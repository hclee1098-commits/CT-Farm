            "description": "표준 JSON 응답. success=true의 data에 결과를 반환합니다."
          },
          "400": {
            "description": "입력 오류"
          },
          "401": {
            "description": "인증 실패"
          },
          "403": {
            "description": "권한 없음"
          },
          "409": {
            "description": "동시 변경 또는 중복 요청 충돌"
          },
          "429": {
            "description": "요청 제한"
          },
          "503": {
            "description": "의존 서비스 사용 불가"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "mfaCode": {
                    "type": "string"
                  }
                },
