{
  "_comment": "filepath: package.json - 웹과 백엔드의 공통 실행 명령을 관리합니다.",
  "name": "secure-fullstack-starter",
  "version": "6.0.0-rc.1",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "brand:build": "node tools/build-brand.mjs",
    "docs:build": "node tools/build-docs-center.mjs",
    "prebuild": "node tools/build-design-tokens.mjs && npm run brand:build && npm run docs:build",
    "mobile:start": "npm --prefix apps/mobile --workspaces=false start",
    "mobile:typecheck": "npm --prefix apps/mobile --workspaces=false run typecheck",
    "mobile:android": "npm --prefix apps/mobile --workspaces=false run android",
    "mobile:ios": "npm --prefix apps/mobile --workspaces=false run ios",
    "test:docs-center": "node --test tools/docs-center.test.mjs",
    "pretest:docs-center": "node tools/build-docs-view.mjs && node tools/build-docs-center.mjs",
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w @starter/api\" \"npm run dev -w @starter/web\"",
    "build": "npm run build -w @starter/api && npm run build -w @starter/web",
    "db:generate": "npm run db:generate -w @starter/api",
    "db:migrate": "npm run db:migrate -w @starter/api",
    "db:deploy": "npm run db:deploy -w @starter/api",
    "test": "npm run test -w @starter/api && npm run test -w @starter/web",
    "start:api": "npm run start -w @starter/api",
    "start:web": "npm run start -w @starter/web",
    "audit": "npm audit",
    "test:api": "npm run test -w @starter/api",
    "test:farm": "node --import tsx tools/test-farm.mts",
    "test:web": "npm run test -w @starter/web",
    "verify": "npm run check:source && npm run db:generate && npm test && npm run test:sql && npm run test:backup && npm run build && npm audit",
    "check:source": "node tools/verify-source.mjs",
    "test:sql": "node tools/test-migrations.mjs",
    "test:backup": "node tools/test-backup.mjs",
    "test:platform": "node tools/test-platform.mjs",
    "test:mail": "node --import tsx tools/test-mail.mts",
    "test:smoke": "node tools/smoke-web.mjs",
    "analyze": "node tools/analyze-project.mjs",
    "predev:portal": "node tools/build-component-preview.mjs && node tools/build-docs-view.mjs",
    "dev:portal": "node tools/dev-portal/server.mjs",
    "test:portal": "node --test tools/dev-portal/portal.test.mjs tools/dev-portal/events.test.mjs tools/developer-event.test.mjs tools/dev-portal/monitor.http.test.mjs",
    "dev:web:observed": "node tools/dev-observed.mjs web",
    "docs:index": "node tools/docs-index.mjs",
    "docs:check": "node tools/docs-index.mjs --check",
    "test:smtp": "node --import tsx tools/test-smtp.mts",
    "dev:api:observed": "node tools/dev-observed.mjs api",
    "verify:platform": "node tools/verify-platform.mjs",
    "test:docs": "node --test tools/dev-portal/docs.test.mjs",
    "pretest:docs": "node tools/build-docs-view.mjs",
    "monitor:collector": "node tools/monitoring/collector.mjs",
    "monitor:hub": "node tools/monitoring/hub.mjs",
    "test:monitoring": "node --test tools/monitoring/monitoring.test.mjs",
    "deploy:server": "node tools/deployment/release.mjs",
    "test:deployment": "node --test tools/deployment/release.test.mjs",
    "test:web-observed": "node --test tools/monitoring/web.integration.test.mjs",
    "test:lifecycle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/test-lifecycle.ps1",
    "test:incidents": "node --test tools/monitoring/incidents.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "concurrently": "^9.2.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "marked": "16.4.1",
    "mermaid": "12.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
