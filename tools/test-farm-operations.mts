import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import type { PrismaClient } from '@prisma/client';
type Reply={status:number;body:any};
type Call=(url:string,method?:string,body?:unknown,auth?:string|null)=>Promise<Reply>;
export async function runOperationsTests(call:Call,deviceCall:(id:string,token:string,data:unknown)=>Promise<Reply>,prisma:PrismaClient,ownerId:string,otherId:string,otherToken:string,pass:(name:string)=>void){
  const farmData={name:'통합 농장',address:'테스트 주소',latitude:37.5,longitude:127,areaM2:1000,crop:'감자',variety:'수미',stage:'GROWING'};
  const farm=await call('','POST',farmData);assert.equal(farm.status,201);const id=farm.body.data.id;
  const plot={name:'첫 필지',areaM2:500,boundary:[[127,37],[127.001,37],[127.001,37.001],[127,37.001]]};
  assert.equal((await call(`/${id}/records`,'POST',{kind:'PLOT',data:{...plot,boundary:[[127,37],[127.001,37.001],[127,37.001],[127.001,37]]}})).status,400);
  const created=await call(`/${id}/records`,'POST',{kind:'PLOT',data:plot});assert.equal(created.status,201);const plotId=created.body.data.id;
  assert.equal((await call(`/${id}/records?kind=PLOT`)).body.data.items[0].data.name,plot.name);
  assert.equal((await call(`/${id}/records/${plotId}`,'PUT',{version:1,data:{...plot,name:'두번째 필지'}})).status,200);
  assert.equal((await call(`/${id}/records/${plotId}`,'PUT',{version:1,data:plot})).status,409);pass('필지 다각형·등록·수정·버전 충돌');
  const crop={name:'감자',variety:'수미',stage:'GROWING',plantingDate:'2026-03-01',harvestDate:'2026-07-01',plotId};
  assert.equal((await call(`/${id}/records`,'POST',{kind:'CROP',data:{...crop,plotId:randomUUID()}})).status,404);
  const cropReply=await call(`/${id}/records`,'POST',{kind:'CROP',data:crop});assert.equal(cropReply.status,201);
  assert.equal((await call(`/${id}/records/${plotId}`,'DELETE',{version:2})).status,409);
  const task=await call(`/${id}/records`,'POST',{kind:'TASK',data:{title:'관수 상태 확인',dueDate:'2026-01-01',status:'TODO',memo:''}});assert.equal(task.status,201);
  for(const kind of ['LEDGER','HARVEST']){const data=kind==='LEDGER'?{title:'비료 구입',date:'2026-10-29',type:'EXPENSE',amountWon:30000,memo:''}:{crop:'감자',date:'2026-10-29',quantityKg:80,memo:''};assert.equal((await call(`/${id}/records`,'POST',{kind,data})).status,201);}
  for(const [url,method,body] of [[`/${id}/records?kind=PLOT`,'GET',undefined],[`/${id}/records`,'POST',{kind:'PLOT',data:plot}],[`/${id}/records/${plotId}`,'PUT',{version:2,data:plot}],[`/${id}/records/${plotId}`,'DELETE',{version:2}]] as const)assert.equal((await call(url,method,body,otherToken)).status,404);
  pass('작기·필지 연결 보호·일정·수확·비용·타인 자료 격리');
  const diary=await call(`/${id}/diary`,'POST',{workDate:'2026-10-29',title:'작업',content:'사진 기록'});const diaryId=diary.body.data.id;
  const ownPhoto=await prisma.storedFile.create({data:{ownerId,storageKey:randomUUID()+'.png',originalName:'시험.png',mimeType:'image/png',size:10}});
  const foreignPhoto=await prisma.storedFile.create({data:{ownerId:otherId,storageKey:randomUUID()+'.png',originalName:'타인.png',mimeType:'image/png',size:10}});
  assert.equal((await call(`/${id}/diary/${diaryId}/photos`,'POST',{fileId:foreignPhoto.id,caption:''})).status,404);
  const link=await call(`/${id}/diary/${diaryId}/photos`,'POST',{fileId:ownPhoto.id,caption:'작물 사진'});assert.equal(link.status,201);
  assert.equal((await call(`/${id}/diary/${diaryId}/photos`)).body.data.length,1);
  assert.equal((await call(`/${id}/diary/${diaryId}/photos`,'GET',undefined,otherToken)).status,404);
  assert.equal((await call(`/${id}/diary/${diaryId}/photos/${link.body.data.id}`,'DELETE')).status,200);
  assert(await prisma.storedFile.findUnique({where:{id:ownPhoto.id}}));pass('사진 소유자 검사·연결·해제 및 원본 파일 보존');
  const sensorInput={name:'토양 센서',kind:'MOISTURE',minValue:20,maxValue:80,staleMinutes:60,simulated:true};
  const sensor=await call(`/${id}/sensors`,'POST',sensorInput);assert.equal(sensor.status,201);assert.equal(sensor.body.data.tokenHash,undefined);assert.equal(sensor.body.data.deviceToken,null);const sensorId=sensor.body.data.id;
  assert.equal((await call(`/${id}/sensors`)).body.data[0].status,'OFFLINE');
  const sample={sampleId:randomUUID(),value:10,measuredAt:new Date().toISOString()};
  assert.equal((await call(`/${id}/sensors/${sensorId}/simulate`,'POST',sample)).status,201);
  assert.equal((await call(`/${id}/sensors/${sensorId}/simulate`,'POST',sample)).status,201);
  assert.equal((await call(`/${id}/sensors/${sensorId}/simulate`,'POST',{...sample,value:15})).status,409);
  assert.equal((await call(`/${id}/sensors/${sensorId}/readings`)).body.data.length,1);
  assert.equal((await call(`/${id}/sensors`)).body.data[0].status,'ALERT');
  assert.equal((await call(`/${id}/sensors/${sensorId}/readings`,'GET',undefined,otherToken)).status,404);
  const real=await call(`/${id}/sensors`,'POST',{...sensorInput,simulated:false});const realId=real.body.data.id,key=real.body.data.deviceToken;
  assert.equal((await deviceCall(realId,'0'.repeat(64),sample)).status,404);
  assert.equal((await deviceCall(realId,key,sample)).status,201);
  assert.equal((await call(`/${id}/sensors/${realId}/simulate`,'POST',sample)).status,400);
  assert.equal((await call(`/${id}/sensors/${realId}`,'DELETE')).status,200);
  assert.equal((await deviceCall(realId,key,{...sample,sampleId:randomUUID()})).status,404);pass('센서 측정·시험/실장치 분리·재전송·범위 이탈·키 폐기·접근 격리');
  const advice=await call(`/${id}/advice`);assert.equal(advice.status,200);assert.equal(advice.body.data.modelConnected,false);assert(advice.body.data.advice.some((a:any)=>a.key==='task:'+task.body.data.id));
  const check1=await call(`/${id}/check`,'POST',{}),check2=await call(`/${id}/check`,'POST',{});assert(check1.body.data.created>0);assert.equal(check2.body.data.created,0);
  assert.equal((await call(`/${id}/consult`,'POST',{question:'농약을 얼마나 쓰나요?'})).status,503);
  assert.equal((await call(`/${id}/weather`)).status,503);pass('근거·한계 표시·알림 중복 방지·미설정 AI/날씨 명시');
  const product=await call(`/${id}/products`,'POST',{name:'감자 5kg',unit:'상자',priceWon:10000,stock:3});assert.equal(product.status,201);const productId=product.body.data.id;
  const orderBody={requestKey:randomUUID(),buyerLabel:'직거래 고객 A',quantity:2};
  const order=await call(`/${id}/products/${productId}/orders`,'POST',orderBody);assert.equal(order.status,201);const orderId=order.body.data.id;
  assert.equal((await call(`/${id}/products/${productId}/orders`,'POST',orderBody)).body.data.id,orderId);
  assert.equal((await call(`/${id}/products/${productId}/orders`,'POST',{...orderBody,quantity:1})).status,409);
  assert.equal((await call(`/${id}/products/${productId}/orders`,'POST',{...orderBody,requestKey:randomUUID(),quantity:2})).status,409);
  assert.equal((await call(`/${id}/products`)).body.data.items[0].stock,1);
  assert.equal((await call(`/${id}/orders/${orderId}`,'PATCH',{status:'CANCELLED'},otherToken)).status,404);
  assert.equal((await call(`/${id}/orders/${orderId}`,'PATCH',{status:'CANCELLED'})).status,200);
  assert.equal((await call(`/${id}/orders/${orderId}`,'PATCH',{status:'CANCELLED'})).status,200);
  assert.equal((await call(`/${id}/products`)).body.data.items[0].stock,3);
  assert.equal((await call(`/${id}/orders/${orderId}`,'PATCH',{status:'COMPLETED'})).status,409);
  assert.equal((await call(`/${id}/orders`,'GET',undefined,otherToken)).status,404);pass('상품·원화 정수 금액·주문 멱등성·재고 차감·취소 복원·중복 취소 보호');
  const parallel=await Promise.all([call(`/${id}/products/${productId}/orders`,'POST',{...orderBody,requestKey:randomUUID(),quantity:2}),call(`/${id}/products/${productId}/orders`,'POST',{...orderBody,requestKey:randomUUID(),quantity:2})]);
  assert.deepEqual(parallel.map(r=>r.status).sort(),[201,409]);assert.equal((await call(`/${id}/products`)).body.data.items[0].stock,1);pass('동시 주문의 재고 초과 판매 방지');
  return id;
}
