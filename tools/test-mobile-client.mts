import test from 'node:test';import assert from 'node:assert/strict';
import {MobileClient,ApiError,apiBase,type StoredSession,type Vault} from '../apps/mobile/src/client.ts';
import {saveEntry,entryBody,type EntryDraft} from '../apps/mobile/src/entry-workflow.ts';
import {createDraftStore} from '../apps/mobile/src/draft-core.ts';
const user={id:'11111111-1111-4111-8111-111111111111',name:'합성 농민',email:'fixture@example.test',role:'USER'},second={...user,id:'22222222-2222-4222-8222-222222222222',email:'second@example.test'};
function memory(initial:StoredSession|null=null){let value=initial;let cleared=0;return {vault:{read:async()=>value,write:async(v:StoredSession)=>{value=v;},clear:async()=>{value=null;cleared++;}} as Vault,peek:()=>value,cleared:()=>cleared};}
const json=(data:unknown,status=200,headers:Record<string,string>={})=>new Response(JSON.stringify(status<400?{success:true,data}:{success:false,errorCode:'TEST_FAILURE',message:'합성 오류'}),{status,headers:{'Content-Type':'application/json',...headers}});
test('손상된 기기 세션도 명시적 새 로그인으로 복구하며 잘못된 응답은 저장하지 않음',async()=>{let stored:StoredSession|null=null,corrupt=true;const vault:Vault={read:async()=>{if(corrupt)throw Error('synthetic corrupt session');return stored;},write:async(v)=>{stored=v;corrupt=false;},clear:async()=>{stored=null;}};let bad=false;const api=new MobileClient('https://api.example.test/api/v1',vault,async()=>json({user,accessToken:'a',refreshToken:bad?{}:'r'.repeat(64)}));await api.login({email:user.email,password:'synthetic'});assert.equal(api.snapshot().status,'ready');bad=true;await assert.rejects(()=>api.login({email:user.email,password:'synthetic'}),(e:any)=>e.code==='INVALID_RESPONSE');assert.equal(typeof stored?.refreshToken,'string');});
test('기기 초안: 재실행 복원·24시간 만료·계정 격리·cold logout 정리',async()=>{const data=new Map<string,string>();let now=100,owner:string|undefined=user.id;const kv={get:async(k:string)=>data.get(k)||null,set:async(k:string,v:string)=>{data.set(k,v);},remove:async(k:string)=>{data.delete(k);}};const first=createDraftStore(kv,async()=>owner,()=>now);await first.write(user.id,'diary',{memo:'합성',requestKey:'fixture'});const reopened=createDraftStore(kv,async()=>owner,()=>now);assert.deepEqual(await reopened.read(user.id,'diary'),{memo:'합성',requestKey:'fixture'});owner=second.id;await assert.rejects(()=>reopened.read(user.id,'diary'));owner=user.id;now+=86400001;assert.equal(await reopened.read(user.id,'diary'),null);await reopened.write(user.id,'schedule',{memo:'합성 일정'});const cold=createDraftStore(kv,async()=>owner,()=>now);await cold.clearUser(user.id);assert.equal(data.size,0);});
test('초안 쓰기와 로그아웃 정리를 직렬화하고 늦은 다른 계정 쓰기 거부',async()=>{const data=new Map<string,string>();let owner:string|undefined=user.id;const store=createDraftStore({get:async(k)=>data.get(k)||null,set:async(k,v)=>{await new Promise(r=>setTimeout(r,10));data.set(k,v);},remove:async(k)=>{data.delete(k);}},async()=>owner);const writing=store.write(user.id,'diary',{memo:'합성'});await new Promise(r=>setTimeout(r,1));owner=undefined;const clear=store.clearUser(user.id);await writing;await clear;await assert.rejects(()=>store.write(user.id,'diary',{memo:'늦은 합성'}));assert.equal(data.size,0);});
test('API 주소·토큰 전송 경계를 HTTPS와 개발 사설망에 제한',async()=>{assert.equal(apiBase('http://10.0.2.2:4000/api/v1',true),'http://10.0.2.2:4000/api/v1');for(const url of ['http://public.example/api/v1','https://u:p@example.test/api/v1','https://example.test/api/v1?key=x'])assert.throws(()=>apiBase(url));const m=memory();const api=new MobileClient(apiBase('https://api.example.test/api/v1'),m.vault,async()=>json({user,accessToken:'access',refreshToken:'r'.repeat(64)}));await api.login({email:user.email,password:'synthetic'});for(const p of ['//elsewhere.test','/../../outside','/%2e%2e/%2e%2e/outside','/\\elsewhere.test'])await assert.rejects(()=>api.request(p));});
test('동시 갱신 공유·Rotation 저장·accessToken 영구 저장 금지',async()=>{const m=memory({refreshToken:'old'.repeat(20),userId:user.id});let refresh=0;const api=new MobileClient('https://api.example.test/api/v1',m.vault,async(url,init)=>{assert.equal(init?.credentials,'omit');if(String(url).endsWith('/refresh')){refresh++;await new Promise(r=>setTimeout(r,10));return json({accessToken:'new-access',refreshToken:'new'.repeat(20)});}return json(user);});await Promise.all([api.refresh(),api.refresh(),api.refresh()]);assert.equal(refresh,1);assert.equal(api.snapshot().status,'ready');assert.equal(m.peek()?.refreshToken,'new'.repeat(20));assert(!JSON.stringify(m.peek()).includes('new-access'));});
test('429 Retry-After 동안 추가 갱신 금지·초안 정리 금지',async()=>{const m=memory({refreshToken:'x'.repeat(64),userId:user.id});let calls=0,clears=0;const api=new MobileClient('https://api.example.test/api/v1',m.vault,async()=>{calls++;return json(null,429,{'Retry-After':'60'});},async()=>{clears++;});await assert.rejects(()=>api.refresh(),(e:any)=>e.status===429);await assert.rejects(()=>api.refresh(),(e:any)=>e.retryAfter>0);assert.equal(calls,1);assert.equal(clears,0);assert(m.peek());});
test('일시 네트워크 장애는 세션·초안을 지우지 않음',async()=>{const m=memory({refreshToken:'x'.repeat(64),userId:user.id});let cleared=0;const api=new MobileClient('https://api.example.test/api/v1',m.vault,async()=>{throw Error('synthetic offline');},async()=>{cleared++;});await api.initialize();assert.equal(api.snapshot().status,'unavailable');assert(m.peek());assert.equal(cleared,0);});
test('401은 해당 사용자 초안과 영구 갱신 토큰 정리',async()=>{const m=memory({refreshToken:'x'.repeat(64),userId:user.id});let owner='';const api=new MobileClient('https://api.example.test/api/v1',m.vault,async()=>json(null,401),async id=>{owner=id||'';});assert.equal(await api.refresh(),false);assert.equal(m.peek(),null);assert.equal(owner,user.id);assert.equal(api.snapshot().status,'guest');});
test('변경 요청 401 이후 자동 재전송하지 않고 GET만 한 번 재시도',async()=>{const m=memory();let writeCount=0;const api=new MobileClient('https://api.example.test/api/v1',m.vault,async(url,init)=>{const p=String(url);if(p.endsWith('/login'))return json({user,accessToken:'a',refreshToken:'x'.repeat(64)});if(p.endsWith('/refresh'))return json({accessToken:'b',refreshToken:'y'.repeat(64)});if(p.endsWith('/me'))return json(user);if(init?.method==='POST'){writeCount++;return json(null,401);}return json({ok:true});});await api.login({email:user.email,password:'synthetic'});await assert.rejects(()=>api.request('/farms',{method:'POST',body:'{}'}),(e:any)=>e.code==='RETRY_CONFIRM');assert.equal(writeCount,1);});
test('이전 계정 조회 응답·다단계 작업을 새 계정에 반환하거나 실행하지 않음',async()=>{const m=memory();let release:(r:Response)=>void=()=>{};const api=new MobileClient('https://api.example.test/api/v1',m.vault,async(url,init)=>String(url).endsWith('/login')?json({user:JSON.parse(String(init?.body)).email===user.email?user:second,accessToken:'a',refreshToken:'x'.repeat(64)}):new Promise<Response>(r=>release=r));await api.login({email:user.email,password:'synthetic'});const scope=api.scope(user.id),pending=api.request('/workspace/dashboard');await Promise.resolve();await api.login({email:second.email,password:'synthetic'});release(json({secret:'fixture-old-user'}));await assert.rejects(()=>pending,(e:any)=>e.code==='SESSION_CHANGED');assert.throws(()=>scope.request('/files',{method:'POST'}),/계정/);assert.equal(api.snapshot().user?.id,second.id);});
test('사진 연결 실패 후 같은 저장 ID로 재개하고 일지를 다시 생성하지 않음',async()=>{let posts=0,links=0,uploads=0;let stored:EntryDraft;const d:EntryDraft={mode:'diary',farmId:user.id,date:'2026-10-30',kind:'물주기',memo:'합성',requestKey:user.id,signature:'',imageUri:'private-fixture'};d.signature=d.mode+d.farmId+JSON.stringify(entryBody(d));const api={request:async<T>(route:string)=>{if(route.endsWith('/diary')){posts++;return {id:second.id} as T;}links++;if(links===1)throw Error('synthetic response lost');return {} as T;}};const persist=async(v:EntryDraft)=>{stored={...v};};const upload=async()=>{uploads++;return {id:user.id};};await assert.rejects(()=>saveEntry(api,d,persist,upload));assert.equal(stored!.savedId,second.id);await saveEntry(api,stored!,persist,upload);assert.equal(posts,1);assert.equal(uploads,1);assert.equal(links,2);});
